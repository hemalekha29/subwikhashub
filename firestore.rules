rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires firebase-tools: npm i -g firebase-tools, then `firebase login` and
// `firebase use <your-project-id>` once — or paste this file's contents directly into
// Firebase Console → Firestore Database → Rules → Publish.)
//
// ── Why these collections are shaped the way they are ──────────────────────────
// `orders` and `pendingOrders` are written ONLY by api/create-order.js and
// api/verify-payment.js using the Firebase Admin SDK, which authenticates with a
// service account and always bypasses these rules entirely — so "deny everything"
// below does not break checkout or Track Order (api/track-order.js), it just makes
// sure NOTHING else (i.e. any random visitor's browser) can read or write them
// directly. See api/create-order.js for the full explanation of why this replaced
// direct client writes.
//
// isAdmin() is a single hardcoded email rather than "any authenticated user" because
// this project has no public sign-up flow in the app UI, but Firebase's public client
// config would still let anyone call createUserWithEmailAndPassword() from a browser
// console if we didn't pin this down — see src/pages/Admin/AdminLogin.jsx.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dreamcraftersevents@gmail.com';
    }

    // Orders contain full customer PII (name, phone, email, address, gift messages,
    // payment IDs) and must never be readable/writable directly by the browser.
    // Reads go through api/track-order.js (customer, by orderId+phone) or the admin
    // panel (see below); writes go through api/verify-payment.js only.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if false; // Only api/verify-payment.js (Admin SDK, bypasses rules) ever creates an order.
    }

    // Gift recipients — the delivery details (name, phone, address) of the person
    // a gift is being sent to. Kept in their own table so this PII is separable
    // from the order/payment data: it can be listed on its own, and erased on its
    // own once the gift is delivered, without touching the order record.
    //
    // The document id IS the order id, so an order finds its recipient record
    // with a direct get — never a query.
    //
    // Created by api/verify-payment.js (Admin SDK) inside the same transaction
    // as the order; updated by the admin panel (delivered stamp / purge).
    match /giftRecipients/{recipientId} {
      allow read, update, delete: if isAdmin();
      allow create: if false; // Only api/verify-payment.js (Admin SDK, bypasses rules) ever creates one.
    }

    // Delivery zones — the pincode → charge configuration the shop manages from
    // /admin/delivery. Publicly readable because the checkout has to look up a
    // zone to show the customer a price; only the admin can change one.
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery settings (the free-delivery threshold, whether the shop has
    // configured its own zones). Publicly readable for the same reason.
    match /deliverySettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Checkout leads — customers who started a checkout but never paid. These
    // hold real customer PII (name, phone, address), so only the admin can read
    // them. They are created by api/create-order.js (Admin SDK), never by the
    // browser.
    //
    // The admin may ONLY change the follow-up fields. The payment and checkout
    // status, the payment reference and the linked order id are written by the
    // server only — a lead can never be marked "paid" from the browser, and a
    // lead can never be pointed at someone else's order.
    match /checkoutLeads/{leadId} {
      allow read: if isAdmin();
      allow create: if false; // Only the server creates leads.
      allow delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.checkoutStatus == resource.data.checkoutStatus
        && request.resource.data.paymentId == resource.data.paymentId
        && request.resource.data.razorpayOrderId == resource.data.razorpayOrderId
        && request.resource.data.linkedOrderId == resource.data.linkedOrderId
        && request.resource.data.grandTotal == resource.data.grandTotal
        && request.resource.data.customer == resource.data.customer
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'followUpStatus', 'followUpNotes', 'lastContactedAt', 'nextFollowUpAt',
             'updatedAt', 'lastActivityAt'
           ]);
    }

    // Checkout-lead settings (abandonment window, retention period).
    match /checkoutSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feedback — customer feedback from the universal feedback form.
    //
    // The browser never writes here directly: feedback goes through
    // api/submit-feedback.js, which validates and sanitises it, applies rate
    // limiting and stamps the trusted fields (reference, status, timestamps).
    // That is why `create` is denied below — a browser write would bypass
    // every one of those checks.
    //
    // Reads are admin-only: feedback can contain a customer's name, phone and
    // order id.
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if false; // Only api/submit-feedback.js (Admin SDK) ever creates one.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Email settings — the address notifications go to, the sender details and
    // which notifications are switched on. Readable by the admin only, because
    // it is the admin's own configuration.
    //
    // No secret is ever stored here: the provider API key lives in the server
    // environment (RESEND_API_KEY / EmailJS keys), never in the database and
    // never in the browser.
    match /emailSettings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Email delivery log — one document per notification attempt, so a webhook
    // that fires twice can never send two emails, and a failed one can be
    // re-sent from the admin panel.
    //
    // The document id IS the notification key. The body is written by the
    // server (Admin SDK) so the browser can never create or alter one — it can
    // only read the log and ask the server to retry.
    match /emailNotifications/{key} {
      allow read, delete: if isAdmin();
      allow create, update: if false; // Only the server writes the log.
    }

    // Only api/create-order.js (Admin SDK) ever touches this collection.
    match /pendingOrders/{orderId} {
      allow read, write: if false;
    }

    // Product catalog: public read (needed for the storefront), admin-only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer-submitted gift reminders (name/email/date) — anyone can create one
    // (that's the point of the feature), nobody can read/list them back except the
    // admin/cron job (which uses the Admin SDK and bypasses this anyway).
    match /reminders/{reminderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Referral codes: publicly readable so a referral link can be validated
    // client-side pre-checkout; only the server (Admin SDK) or admin creates/updates them.
    match /referrals/{referralId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // UGC gallery: public reads only for approved photos; admin manages everything.
    match /gallery/{itemId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow write: if isAdmin();
    }

    // Wishlist analytics events: write-only from any visitor (fire-and-forget
    // tracking beacon), readable only by the admin analytics dashboard.
    match /wishlistEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Game leaderboard: public read (it's a leaderboard), anyone can submit a score.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
